# Scam Shield Environment Variables
PROJECT_NAME="Scam Shield"
API_V1_STR="/api"
SECRET_KEY="replace_with_a_secure_random_jwt_secret_key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Threat Intelligence APIs (Optional - if missing, system operates in Safe Heuristic/Demo Mode)
VIRUSTOTAL_API_KEY=""
GOOGLE_SAFE_BROWSING_API_KEY=""
